{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly"
  ],
  "configMigration": true,
  "minimumReleaseAge": "5 days",
  "semanticCommits": "enabled",
  "separateMajorMinor": false,
  "platformAutomerge": false,
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths",
    "pnpmDedupe"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "semanticCommitType": "fix"
  },
  "customManagers": [
    {
      "description": "Versions pinned in a workflow or action, marker trailing the value",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.(gitea|github)/(workflows|actions)/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "[A-Za-z0-9_]+_VERSION[ \\t]*:[ \\t]*[\"']?(?<currentValue>[^\\s\"']+)[\"']?[ \\t]*# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+) depName=(?<depName>\\S+)(?: (?:lookupName|packageName)=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?(?: registryUrl=(?<registryUrl>\\S+))?"
      ]
    },
    {
      "description": "Tool packages and images pinned in a Makefile",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "[A-Z_]+_PACKAGE\\s*\\?=\\s*(?<depName>[^@\\s]+?)(?:/cmd/[^@/\\s]+)?@(?<currentValue>\\S+)\\s+# renovate: datasource=(?<datasource>\\S+)",
        "[A-Z_]+_IMAGE\\s*\\?=\\s*(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)\\s+# renovate: datasource=(?<datasource>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Single weekly PR for all dependency updates",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "dependencies",
      "semanticCommitType": "chore"
    }
  ]
}
